FRONTEND_DOMAIN=uorconnect.space, www.uorconnect.space
API_DOMAIN=api.uorconnect.space
LAB_BASE_PATH=/
POSTGRES_DB=uorconnect
POSTGRES_USER=uorconnect
POSTGRES_PASSWORD=change-me-strong-password
EVOLUTION_POSTGRES_DB=evolution
# Opcional: defina DATABASE_URL se a password tiver caracteres reservados como #, @, / ou :
# DATABASE_URL=postgresql://uorconnect:change-me%23encoded@postgres:5432/uorconnect?schema=public
JWT_SECRET=change-me-with-at-least-16-characters
CORS_ORIGIN=https://uorconnect.space,https://www.uorconnect.space
PUBLIC_API_URL=https://api.uorconnect.space
PUBLIC_APP_URL=https://uorconnect.space
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.6
EVOLUTION_API_BASE_URL=http://evolution-api:8080
EVOLUTION_SERVER_URL=http://evolution-api:8080
EVOLUTION_CORS_ORIGIN=*
AUTHENTICATION_API_KEY=change-me-evolution-api-key
EVOLUTION_API_KEY=change-me-evolution-api-key
EVOLUTION_LOG_LEVEL=ERROR
EVOLUTION_DEL_INSTANCE=false
RATE_LIMIT_MAX=400
RATE_LIMIT_WINDOW_MS=60000
PGPOOL_MAX=20
PGPOOL_MIN=2
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECT_TIMEOUT_MS=8000
BACKUP_DIR=/opt/uorconnect/backups
