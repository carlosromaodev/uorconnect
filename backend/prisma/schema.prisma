  @@unique([challengeId, studentNumber, challengeVersion, attemptNumber])
  @@index([studentNumber, answeredAt])
  @@index([challengeId, correct])
}

model PassportSurpriseQr {
  id                     Int       @id @default(autoincrement())
  qrAction               QrAction  @relation(fields: [qrActionId], references: [id], onDelete: Cascade)
  qrActionId             Int       @unique
  displayCode            String?   @unique
  batchCode              String?
  name                   String
  description            String?
  effectType             String
  effectValue            Int       @default(0)
  dynamicRulesJson       String?
  targetScope            String    @default("SURPRISE_BONUS")
  rarity                 String    @default("COMMON")
  visibility             String    @default("VISIBLE")
  maxUsesTotal           Int?
  maxUsesPerStudent      Int       @default(1)
  negativeCapPerStudent  Int?
  active                 Boolean   @default(true)
  startsAt               DateTime?
  endsAt                 DateTime?
  printedAt              DateTime?
  createdByStudentNumber String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  effects                PassportSurpriseEffectLedger[]

  @@index([effectType, active])
  @@index([batchCode, createdAt])
  @@index([rarity, active])
  @@index([startsAt, endsAt])
  @@index([createdAt])
}

model PassportSurpriseEffectLedger {
  id             Int       @id @default(autoincrement())
  businessKey    String    @unique
  surpriseQr     PassportSurpriseQr? @relation(fields: [surpriseQrId], references: [id], onDelete: SetNull)
  surpriseQrId   Int?
  qrAction       QrAction? @relation(fields: [qrActionId], references: [id], onDelete: SetNull)
  qrActionId     Int?
  qrActionScanId Int?
  student        Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId      Int?
  studentNumber  String
  studentName    String?
  studentCourse  String?
  effectType     String
  effectValue    Int
  targetScope    String
  beforePoints   Int
  afterPoints    Int
  deltaPoints    Int
  status         String    @default("VALID")
  message        String?
  metadataJson   String?
  appliedAt      DateTime  @default(now())

  @@index([studentNumber, appliedAt])
  @@index([studentId, appliedAt])
  @@index([surpriseQrId, appliedAt])
  @@index([qrActionId, appliedAt])
  @@index([effectType, appliedAt])
  @@index([status, appliedAt])
}

model PassportScan {
  id             Int       @id @default(autoincrement())
  businessKey    String    @unique
  student        Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId      Int?
  studentNumber  String
  studentName    String?
  studentCourse  String?
  mission        PassportMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  missionId      Int?
  qrAction       QrAction? @relation(fields: [qrActionId], references: [id], onDelete: SetNull)
  qrActionId     Int?
  qrActionScan   QrActionScan? @relation(fields: [qrActionScanId], references: [id], onDelete: SetNull)
  qrActionScanId Int?      @unique
  result         String
  pointsAwarded  Int       @default(0)
  message        String?
  metadataJson   String?
  reviewStatus   String    @default("AUTO")
  reviewedAt     DateTime?
  reviewedByStudentNumber String?
  reviewNote     String?
  scannedAt      DateTime  @default(now())

  @@index([studentNumber, scannedAt])
  @@index([studentId, scannedAt])
  @@index([missionId, scannedAt])
  @@index([qrActionId])
  @@index([result, scannedAt])
  @@index([reviewStatus, scannedAt])
}

model PassportPointLedger {
