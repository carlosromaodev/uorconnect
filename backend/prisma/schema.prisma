generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum SubmissionType {
  PROJECT
  BUSINESS
  PRODUCT
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AgendaDay {
  DAY1
  DAY2
}

enum AgendaType {
  PANEL
  WORKSHOP
  PRESENTATION
  CEREMONY
  BREAK
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  createdAt   DateTime     @default(now())
  submissions Submission[] @relation("UserSubmissions")
  votes       Vote[]
  reviews     Review[]
}

model Student {
  id                Int                @id @default(autoincrement())
  studentNumber     String             @unique
  name              String?
  email             String?
  course            String?
  classCode         String?
  academicYear      String?
  academicPeriod    String?
  curricularYear    String?
  academicSyncedAt  DateTime?
  birthDate         DateTime?
  nationality       String?
  phone             String?
  alternatePhone    String?
  avatarUrl         String?
  university        String?
  isUorStudent      Boolean?
  registrationSource String?
  bio               String?
  address           String?
  instagramUrl      String?
  facebookUrl       String?
  linkedinUrl       String?
  githubUrl         String?
  websiteUrl        String?
  profileCompletedAt DateTime?
  deletedAt         DateTime?
  deletionReason    String?
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  submissions       Submission[]
  likes             StudentLike[]
  courseLikes       CourseLike[]
  courseEnrollments CourseEnrollment[]
  votes             StudentVote[]
  comments          StudentComment[]
  liveChatMessages  LiveChatMessage[]
  liveChatReactions LiveChatReaction[]
  submissionMemberships SubmissionMember[]
  analyticsSessions AnalyticsSession[]
  analyticsEvents   AnalyticsEvent[]
  consentRecords    ConsentRecord[]
  loginAudits       StudentLoginAudit[]
  odinEvents        OdinEvent[]
  accessCodes       StudentAccessCode[]
  smsRecipients     SmsCampaignRecipient[]
  whatsappRecipients WhatsAppCampaignRecipient[]
  attendanceCredential AttendanceCredential?
  attendanceCheckIns AttendanceCheckIn[]
  certificates      Certificate[]
  profileExtra      StudentProfileExtra?
  qrActionScans         QrActionScan[]
  passportScans         PassportScan[]
  passportPointLedger   PassportPointLedger[]
  passportPointRecoveries PassportPointRecovery[]
  passportStudentBadges PassportStudentBadge[]
  passportChallengeAnswers PassportChallengeAnswer[]
  passportSurpriseEffects PassportSurpriseEffectLedger[]
  exhibitorVoteScoreEvents ExhibitorScoreEvent[] @relation("ExhibitorScoreVoter")
  exhibitorActorScoreEvents ExhibitorScoreEvent[] @relation("ExhibitorScoreActor")
  teamMemberships       TeamMembership[]
  teamMembershipClaims  TeamMembershipClaim[]
}

model StudentProfileExtra {
  id                         Int      @id @default(autoincrement())
  student                    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId                  Int      @unique
  bio                        String?
  address                    String?
  instagramUrl               String?
  facebookUrl                String?
  linkedinUrl                String?
  githubUrl                  String?
  websiteUrl                 String?
  consentPhotoCredential     Boolean  @default(false)
  consentPublicProfile       Boolean  @default(false)
  consentSocialLinks         Boolean  @default(false)
  consentSms                 Boolean  @default(false)
  consentWhatsapp            Boolean  @default(false)
  visibilityJson             String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([studentId])
  @@index([updatedAt])
}

enum StudentLoginOrigin {
  UORCONNECT
  LABORATORIO
  CONVENTIONAL
}

enum AnalyticsAudience {
  ANONYMOUS
  AUTHENTICATED
}

enum AnalyticsCategory {
  NAVIGATION
  ENGAGEMENT
  CONVERSION
  LIVE
  AUTH
  MARKETING
  FUNCTIONAL
  CONSENT
  SECURITY
}

model AdminAuthorizedStudent {
  id                     Int      @id @default(autoincrement())
  studentNumber          String   @unique
  team                   String   @default("Geral")
  role                   String   @default("SUPER_ADMIN")
  permissions            String   @default("ALL")
  isActive               Boolean  @default(true)
  revokedAt              DateTime?
  revokedByStudentNumber String?
  revocationReason       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([isActive, studentNumber])
}

model TeamMembership {
  id                     Int      @id @default(autoincrement())
  studentNumber          String?
  student                Student? @relation(fields: [studentNumber], references: [studentNumber], onDelete: SetNull, onUpdate: Cascade)
  fullName               String
  firstName              String?
  lastName               String?
  category               String   @default("NUCLEO")
  team                   String   @default("Núcleo")
  role                   String   @default("Membro")
  accessLevel            String   @default("Membro")
  permissions            String   @default("")
  status                 String   @default("ACTIVE")
  version                Int      @default(1)
  mandateLabel           String?
  startsAt               DateTime?
  endsAt                 DateTime?
  source                 String   @default("MANUAL")
  notes                  String?
  createdByStudentNumber String?
  verifiedAt             DateTime?
  verifiedByStudentNumber String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  credentials            EventTeamCredential[]
  claims                 TeamMembershipClaim[]
  assignedTasks          AdminTask[] @relation("AdminTaskAssignee")

  @@index([studentNumber])
  @@index([status, team])
  @@index([category, role])
  @@index([fullName])
  @@index([verifiedAt])
}

model TeamMembershipClaim {
  id                         Int       @id @default(autoincrement())
  student                    Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  studentId                  Int?
  studentNumber              String
  officialName               String?
  officialEmail              String?
  officialCourse             String?
  officialPhone              String?
  requestedCategory          String    @default("NUCLEO")
  requestedTeam              String
  requestedRole              String
  requestedAccessLevel       String    @default("Membro")
  requestedPermissions       String    @default("")
  status                     String    @default("PENDING_REVIEW")
  photoUrl                   String?
  email                      String?
  phone                      String?
  course                     String?
  organization               String?
  bio                        String?
  address                    String?
  instagramUrl               String?
  facebookUrl                String?
  linkedinUrl                String?
  githubUrl                  String?
  websiteUrl                 String?
  consentPhotoCredential     Boolean   @default(false)
  consentPublicProfile       Boolean   @default(false)
  consentSocialLinks         Boolean   @default(false)
  consentSms                 Boolean   @default(false)
  consentWhatsapp            Boolean   @default(false)
  sourceToken                String?
  reviewNote                 String?
  reviewedAt                 DateTime?
  reviewedByStudentNumber    String?
  teamMembership             TeamMembership? @relation(fields: [teamMembershipId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teamMembershipId           Int?
  credential                 EventTeamCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  credentialId               Int?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([studentNumber, status])
  @@index([status, createdAt])
  @@index([requestedTeam, requestedRole])
  @@index([teamMembershipId])
  @@index([credentialId])
}

model AdminTask {
  id                     String                @id @default(uuid())
  title                  String
  description            String                @default("")
  status                 String                @default("todo")
  priority               String                @default("medium")
  category               String                @default("")
  assigneeMembershipId   Int?
  assignee               TeamMembership?       @relation("AdminTaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assigneeName           String?
  assigneePhone          String?
  dueDate                DateTime?
  createdByStudentNumber String?
  createdByName          String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  attachments            AdminTaskAttachment[]

  @@index([status, priority])
  @@index([assigneeMembershipId])
  @@index([dueDate])
  @@index([createdAt])
}

model AdminTaskAttachment {
  id        String    @id @default(uuid())
  taskId    String
  task      AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name      String
  dataUrl   String
  addedAt   DateTime  @default(now())

  @@index([taskId])
}

model PdfDocumentJob {
  id                     String   @id @default(uuid())
  kind                   String
  businessKey            String   @unique
  status                 String   @default("queued")
  fileName               String
  filePath               String?
  contentType            String   @default("application/pdf")
  sizeBytes              Int?
  error                  String?
  inputHash              String?
  snapshotJson           String?
  createdByStudentNumber String?
  attempts               Int      @default(0)
  lockedAt               DateTime?
  lockOwner              String?
  startedAt              DateTime?
  completedAt            DateTime?
  expiresAt              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([kind, status])
  @@index([expiresAt])
  @@index([createdAt])
}

model JuryMember {
  id             Int              @id @default(autoincrement())
  name           String
  phone          String           @unique
  team           String           @default("Júri")
  role           String           @default("TEAM_LEAD")
  permissions    String           @default("OVERVIEW,SUBMISSIONS,VOTES,WINNERS")
  isActive       Boolean          @default(true)
  lastCodeSentAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  accessCodes    JuryAccessCode[]

  @@index([isActive, createdAt])
}

model JuryAccessCode {
  id                   Int        @id @default(autoincrement())
  juryMember           JuryMember @relation(fields: [juryMemberId], references: [id], onDelete: Cascade)
  juryMemberId         Int
  codeHash             String
  codeLast4            String
  expiresAt            DateTime
  usedAt               DateTime?
  sentAt               DateTime   @default(now())
  createdByStudentNumber String
  providerMessageId    String?
  providerResponseJson String?
  deliveryStatus       String     @default("PENDING")
  errorMessage         String?

  @@index([juryMemberId, sentAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model EventTeamCredential {
  id                     Int       @id @default(autoincrement())
  teamMembershipId       Int?
  teamMembership         TeamMembership? @relation(fields: [teamMembershipId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  token                  String    @unique
  publicSlug             String    @unique
  category               String    @default("NUCLEO")
  team                   String    @default("Núcleo")
  role                   String    @default("Membro")
  accessLevel            String    @default("Membro")
  permissions            String    @default("")
  status                 String    @default("INVITED")
  name                   String?
  email                  String?
  phone                  String?
  course                 String?
  organization           String?
  bio                    String?
  photoUrl               String?
  address                String?
  instagramUrl           String?
  facebookUrl            String?
  linkedinUrl            String?
  githubUrl              String?
  websiteUrl             String?
  consentPhotoCredential Boolean   @default(false)
  consentPublicProfile   Boolean   @default(false)
  consentSocialLinks     Boolean   @default(false)
  consentSms             Boolean   @default(false)
  consentWhatsapp        Boolean   @default(false)
  sourceSubmissionId     Int?
  sourceSubmissionRef    String?
  sourceSubmissionName   String?
  sourceSubmissionType   String?
  sourceSubmissionArea   String?
  notes                  String?
  createdByStudentNumber String?
  issuedAt               DateTime?
  issuedByStudentNumber  String?
  issuedSnapshotJson     String?
  invitationExpiresAt    DateTime?
  expiresAt              DateTime?
  revokedAt              DateTime?
  revokedReason          String?
  version                Int       @default(1)
  reissuedFromId         Int?
  submittedAt            DateTime?
  lastPassIssuedAt       DateTime?
  lastPassSnapshotJson   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  membershipClaims       TeamMembershipClaim[]
  printBatchItems        CredentialPrintBatchItem[]

  @@index([teamMembershipId])
  @@index([invitationExpiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([reissuedFromId])
  @@index([team, category])
  @@index([status, createdAt])
  @@index([category, role])
  @@index([sourceSubmissionId])
}

model CredentialPrintTemplate {
  id                     Int      @id @default(autoincrement())
  category               String   @unique
  primaryColor           String
  accentColor            String
  lightColor             String
  footerLabel            String?
  updatedByStudentNumber String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([updatedAt])
}

model CredentialPrintBatch {
  id                     Int                         @id @default(autoincrement())
  code                   String                      @unique
  title                  String
  mode                   String                      @default("MIXED")
  status                 String                      @default("READY")
  totalItems             Int                         @default(0)
  createdByStudentNumber String?
  notes                  String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  items                  CredentialPrintBatchItem[]

  @@index([mode, createdAt])
  @@index([status, createdAt])
}

model CredentialPrintBatchItem {
  id           Int                   @id @default(autoincrement())
  batchId      Int
  batch        CredentialPrintBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  credentialId Int
  credential   EventTeamCredential  @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  position     Int
  label        String?
  itemType     String                @default("NOMINAL")
  createdAt    DateTime              @default(now())

  @@unique([batchId, credentialId])
  @@unique([batchId, position])
  @@index([credentialId])
}

model StudentLoginAudit {
  id            Int                @id @default(autoincrement())
  student       Student            @relation(fields: [studentId], references: [id])
  studentId     Int
  studentNumber String
  origin        StudentLoginOrigin
  loggedAt      DateTime           @default(now())

  @@index([loggedAt])
  @@index([studentId, loggedAt])
  @@index([origin, loggedAt])
}

model OdinDevice {
  id            Int         @id @default(autoincrement())
  deviceId      String      @unique
  firstSeenAt   DateTime    @default(now())
  lastSeenAt    DateTime    @default(now())
  lastIp        String?
  lastUserAgent String?
  loginCount    Int         @default(0)
  voteCount     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        OdinEvent[]

  @@index([lastSeenAt])
  @@index([lastIp, lastSeenAt])
}

model OdinEvent {
  id              Int        @id @default(autoincrement())
  device          OdinDevice @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  deviceId        String
  student         Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId       Int?
  studentNumber   String?
  studentName     String?
  studentCourse   String?
  eventType       String
  targetType      String?
  targetId        Int?
  targetLabel     String?
  ipAddress       String?
  userAgent       String?
  riskContextJson String?
  createdAt       DateTime   @default(now())

  @@index([deviceId, createdAt])
  @@index([studentId, createdAt])
  @@index([studentNumber, createdAt])
  @@index([eventType, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([ipAddress, createdAt])
}

model OdinAiAnalysis {
  id                     Int      @id @default(autoincrement())
  caseType               String
  caseId                 String
  riskScore              Int
  riskLevel              String
  narrative              String
  fraudProbability       Int
  legitimateProbability  Int
  mostLikelyScenario     String
  alternativeScenario    String
  recommendation         String
  confidenceLevel        String
  actionType             String
  patternType            String?
  actionUrgency          String?
  operationalState       String   @default("OPEN")
  ruleRiskScore          Int?
  unifiedRiskScore       Int?
  consistencyCheck       String   @default("NOT_EVALUATED")
  consistencyReason      String?
  evidenceSummary        String?
  commentAnalysis        String?
  alternativePlausibility String?
  recommendedAction      String?
  votesToReview          Int?
  accountsToReview       Int?
  notifyExpositor        Boolean  @default(false)
  cannotBeFalsePositiveIf String?
  modelVersion           String
  promptVersion          String
  tokensUsed             Int?
  payloadHash            String
  rawResponseJson        String?
  createdByStudentNumber String?
  createdAt              DateTime @default(now())
  feedback               OdinAiFeedback[]

  @@index([caseType, caseId, createdAt])
  @@index([riskLevel, createdAt])
  @@index([actionType, createdAt])
  @@index([patternType, createdAt])
  @@index([actionUrgency, createdAt])
  @@index([consistencyCheck, createdAt])
  @@index([payloadHash])
}

model OdinAiFeedback {
  id                     Int            @id @default(autoincrement())
  analysis               OdinAiAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  analysisId             Int
  actorStudentNumber     String?
  useful                 Boolean
  recommendationCorrect  Boolean?
  realityMatched         Boolean?
  note                   String?
  createdAt              DateTime       @default(now())

  @@index([analysisId, createdAt])
  @@index([actorStudentNumber, createdAt])
}

model OdinProjectPenalty {
  id                         Int        @id @default(autoincrement())
  submission                 Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId               Int
  penaltyMode                String
  requestedVoteCount         Int?
  removedVoteCount           Int        @default(0)
  removedPointCount          Float      @default(0)
  reason                     String
  automationProofSummary     String?
  automationProofUrl         String?
  automationEvidenceJson     String?
  automationConfidence       Int?
  affectedVoteIdsJson        String?
  affectedStudentIdsJson     String?
  affectedScoreEventIdsJson  String?
  notifiedProjectMembers     Boolean    @default(true)
  createdByStudentNumber     String?
  createdAt                  DateTime   @default(now())
  revokedAt                  DateTime?
  revokedByStudentNumber     String?
  revokeReason               String?

  @@index([submissionId, createdAt])
  @@index([penaltyMode, createdAt])
  @@index([createdByStudentNumber, createdAt])
}

model CredentialValidationLog {
  id           Int      @id @default(autoincrement())
  tokenHash    String
  kind         String
  credentialId String?
  status       String?
  valid        Boolean  @default(false)
  source       String   @default("PUBLIC_VALIDATION")
  ipHash       String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
  @@index([tokenHash, createdAt])
  @@index([credentialId, createdAt])
}

model StudentAccessCode {
  id                   Int       @id @default(autoincrement())
  student              Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId            Int?
  phone                String
  codeHash             String
  codeLast4            String
  expiresAt            DateTime
  usedAt               DateTime?
  sentAt               DateTime  @default(now())
  purpose              String    @default("CONVENTIONAL_LOGIN")
  providerMessageId    String?
  providerResponseJson String?
  deliveryStatus       String    @default("PENDING")
  errorMessage         String?

  @@index([phone, sentAt])
  @@index([studentId, sentAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model StudentLike {
  id           Int        @id @default(autoincrement())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  createdAt    DateTime   @default(now())

  @@unique([studentId, submissionId])
  @@index([submissionId, createdAt])
}

model StudentVote {
  id           Int        @id @default(autoincrement())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  eventKey     String     @default("main-event")
  createdAt    DateTime   @default(now())

  @@unique([studentId, submissionId, eventKey])
  @@index([submissionId, createdAt])
  @@index([submissionId, eventKey, createdAt])
}

model StudentComment {
  id                         Int        @id @default(autoincrement())
  student                    Student    @relation(fields: [studentId], references: [id])
  studentId                  Int
  submission                 Submission @relation(fields: [submissionId], references: [id])
  submissionId               Int
  content                    String
  moderationStatus           String     @default("PENDING")
  feedbackReviewedAt         DateTime?
  feedbackReviewedByStudentNumber String?
  feedbackReviewNote         String?
  feedbackScoredAt           DateTime?
  createdAt                  DateTime   @default(now())

  @@index([submissionId, createdAt])
  @@index([studentId, createdAt])
  @@index([moderationStatus, createdAt])
}

model Submission {
  id               Int              @id @default(autoincrement())
  referenceCode    String           @unique
  type             SubmissionType
  status           SubmissionStatus @default(PENDING)
  name             String
  description      String
  area             String
  course           String?
  stage            String?
  category         String?
  productType      String?
  teamSize         Int
  members          String
  leaderName       String?
  leaderPhone      String?
  leaderEmail      String
  needs            String
  paymentProof     String
  paymentConfirmed Boolean          @default(false)
  paymentStatus    String           @default("PENDING_REVIEW")
  paymentSubmittedAt DateTime?
  paymentReviewedAt DateTime?
  paymentReviewedByStudentNumber String?
  paymentReviewNote String?
  repoUrl          String?
  websiteUrl       String?
  instagramUrl     String?
  facebookUrl      String?
  linkedinUrl      String?
  githubUrl        String?
  observations     String?
  agreeRules       Boolean
  primaryColor     String           @default("#FD8305")
  secondaryColor   String           @default("#223D42")
  bannerUrl        String?
  teamInviteToken  String?
  teamInviteSentAt DateTime?
  projectFrozen    Boolean          @default(false)
  projectFrozenAt  DateTime?
  projectFrozenByStudentNumber String?
  projectFreezeReason String?
  isWinner         Boolean          @default(false)
  winnerSelectedAt DateTime?
  deletedAt        DateTime?
  deletedByStudentNumber String?
  deletionReason   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  leader           User             @relation("UserSubmissions", fields: [leaderId], references: [id])
  leaderId         Int
  student          Student?         @relation(fields: [studentId], references: [id])
  studentId        Int?
  studentNumberSnapshot String?
  votes            Vote[]
  reviews          Review[]
  studentLikes     StudentLike[]
  studentVotes     StudentVote[]
  studentComments  StudentComment[]
  memberConfirmations SubmissionMember[]
  exhibitorScoreEvents ExhibitorScoreEvent[]
  odinProjectPenalties OdinProjectPenalty[]

  @@index([status, createdAt])
  @@index([type, status, createdAt])
  @@index([studentId, createdAt])
  @@index([teamInviteToken])
  @@index([paymentStatus, updatedAt])
  @@index([projectFrozen, status, createdAt])
}

model SubmissionMember {
  id               Int        @id @default(autoincrement())
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId     Int
  name             String
  normalizedName   String
  student          Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId        Int?
  expectedStudentNumber String?
  studentNumber    String?
  studentName      String?
  studentCourse    String?
  studentPhone     String?
  isExternal        Boolean    @default(false)
  externalOrganization String?
  externalReason   String?
  exceptionApprovedAt DateTime?
  exceptionApprovedByStudentNumber String?
  confirmedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  exhibitorScoreEvents ExhibitorScoreEvent[]

  @@unique([submissionId, normalizedName])
  @@unique([submissionId, studentId])
  @@index([submissionId, confirmedAt])
  @@index([submissionId, expectedStudentNumber])
  @@index([studentId, confirmedAt])
  @@index([studentNumber])
  @@index([isExternal, exceptionApprovedAt])
}

model SubmissionConfig {
  key                 String   @id @default("default")
  isOpen              Boolean  @default(true)
  votingPaused        Boolean  @default(false)
  iban                String   @default("AO006 0055 0000 3295 0561 10379")
  accountName         String   @default("Universidade Óscar Ribas")
  paymentAmount       String   @default("3.500 Kz")
  paymentInstructions String?
  projectCommunityUrl String?
  businessCommunityUrl String?
  productCommunityUrl String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Vote {
  id           Int        @id @default(autoincrement())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  voter        User       @relation(fields: [voterId], references: [id])
  voterId      Int
  createdAt    DateTime   @default(now())

  @@unique([submissionId, voterId])
}

model ExhibitorScoreConfig {
  id                     Int      @id @default(autoincrement())
  version                Int      @unique
  eventKey               String   @default("main-event")
  status                 String   @default("ACTIVE")
  active                 Boolean  @default(true)
  weightsJson            String   @default("{}")
  roundsJson             String   @default("[]")
  streakBonusesJson      String   @default("[]")
  startsAt               DateTime?
  endsAt                 DateTime?
  lockedAt               DateTime?
  createdByStudentNumber String?
  createdAt              DateTime @default(now())
