generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum SubmissionType {
  PROJECT
  BUSINESS
  PRODUCT
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AgendaDay {
  DAY1
  DAY2
}

enum AgendaType {
  PANEL
  WORKSHOP
  PRESENTATION
  CEREMONY
  BREAK
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  createdAt   DateTime     @default(now())
  submissions Submission[] @relation("UserSubmissions")
  votes       Vote[]
  reviews     Review[]
}

model Student {
  id                Int                @id @default(autoincrement())
  studentNumber     String             @unique
  name              String?
  email             String?
  course            String?
  birthDate         DateTime?
  nationality       String?
  phone             String?
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  submissions       Submission[]
  likes             StudentLike[]
  courseLikes       CourseLike[]
  courseEnrollments CourseEnrollment[]
  votes             StudentVote[]
  comments          StudentComment[]
  liveChatMessages  LiveChatMessage[]
  analyticsSessions AnalyticsSession[]
  analyticsEvents   AnalyticsEvent[]
  consentRecords    ConsentRecord[]
  loginAudits       StudentLoginAudit[]
}

enum StudentLoginOrigin {
  UORCONNECT
  LABORATORIO
}

enum AnalyticsAudience {
  ANONYMOUS
  AUTHENTICATED
}

enum AnalyticsCategory {
  NAVIGATION
  ENGAGEMENT
  CONVERSION
  LIVE
  AUTH
  MARKETING
  FUNCTIONAL
  CONSENT
  SECURITY
}

model AdminAuthorizedStudent {
  id            Int      @id @default(autoincrement())
  studentNumber String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StudentLoginAudit {
  id            Int                @id @default(autoincrement())
  student       Student            @relation(fields: [studentId], references: [id])
  studentId     Int
  studentNumber String
  origin        StudentLoginOrigin
  loggedAt      DateTime           @default(now())

  @@index([loggedAt])
  @@index([studentId, loggedAt])
  @@index([origin, loggedAt])
}

model StudentLike {
  id           Int        @id @default(autoincrement())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  createdAt    DateTime   @default(now())

  @@unique([studentId, submissionId])
}

model StudentVote {
  id           Int        @id @default(autoincrement())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  createdAt    DateTime   @default(now())

  @@unique([studentId, submissionId])
}

model StudentComment {
  id           Int        @id @default(autoincrement())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  content      String
  createdAt    DateTime   @default(now())
}

model Submission {
  id               Int              @id @default(autoincrement())
  referenceCode    String           @unique
  type             SubmissionType
  status           SubmissionStatus @default(PENDING)
  name             String
  description      String
  area             String
  course           String?
  stage            String?
  category         String?
  productType      String?
  teamSize         Int
  members          String
  leaderName       String?
  leaderPhone      String?
  leaderEmail      String
  needs            String
  paymentProof     String
  paymentConfirmed Boolean          @default(false)
  repoUrl          String?
  websiteUrl       String?
  observations     String?
  agreeRules       Boolean
  primaryColor     String           @default("#FD8305")
  secondaryColor   String           @default("#223D42")
  bannerUrl        String?
  isWinner         Boolean          @default(false)
  winnerSelectedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  leader           User             @relation("UserSubmissions", fields: [leaderId], references: [id])
  leaderId         Int
  student          Student?         @relation(fields: [studentId], references: [id])
  studentId        Int?
  studentNumberSnapshot String?
  votes            Vote[]
  reviews          Review[]
  studentLikes     StudentLike[]
  studentVotes     StudentVote[]
  studentComments  StudentComment[]

  @@index([studentId, createdAt])
}

model SubmissionConfig {
  key                 String   @id @default("default")
  isOpen              Boolean  @default(true)
  iban                String   @default("AO006 0055 0000 3295 0561 10379")
  accountName         String   @default("Universidade Óscar Ribas")
  paymentAmount       String   @default("15.000 Kz")
  paymentInstructions String?
  projectCommunityUrl String?
  businessCommunityUrl String?
  productCommunityUrl String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Vote {
  id           Int        @id @default(autoincrement())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  voter        User       @relation(fields: [voterId], references: [id])
  voterId      Int
  createdAt    DateTime   @default(now())

  @@unique([submissionId, voterId])
}

model Review {
  id           Int        @id @default(autoincrement())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  reviewer     User       @relation(fields: [reviewerId], references: [id])
  reviewerId   Int
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([submissionId, reviewerId])
}

model Speaker {
  id        Int      @id @default(autoincrement())
  name      String
  bio       String
  specialty String
  talk      String
  day       String
  linkedin  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id          Int      @id @default(autoincrement())
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuideStep {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  link        String?
  linkText    String?
  icon        String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuideTip {
  id          Int      @id @default(autoincrement())
  content     String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Venue {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  capacity    String
  floor       String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeCourse {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String
  ctaText     String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeSocialConfig {
  key                     String   @id @default("default")
  instagramUrl            String?
  facebookUrl             String?
  linkedinUrl             String?
  courseEnrollmentEnabled Boolean  @default(true)
  firstYearContestEnabled Boolean  @default(true)
  primaryColor            String   @default("#f97316")
  primaryGradient         String   @default("linear-gradient(135deg, rgba(249,115,22,0.16) 0%, rgba(251,146,60,0.28) 100%)")
  titleColor              String   @default("#111827")
  accentColor             String   @default("#f97316")
  dashedColor             String   @default("#f97316")
  dashedOpacity           Int      @default(35)
  heroIconsOpacity        Int      @default(18)
  heroBlobsIntensity      Int      @default(68)
  heroMeshEnabled         Boolean  @default(true)
  heroBadgeText           String   @default("Plataforma Académica Digital · Chave-na-Mão")
  heroTitlePrefix         String   @default("3ª edição da")
  heroTitleHighlight      String   @default("Feira do Dia das Telecomunicações")
  heroSubtitleText        String   @default("Conectando o Conhecimento Académico ao Mercado Tecnológico com Energia e Empreendedorismo.")
  heroSubtitleColor       String   @default("#4b5563")
  heroTitleMobileSize     String   @default("2.8rem")
  heroTitleTabletSize     String   @default("4.2rem")
  heroTitleDesktopSize    String   @default("5.4rem")
  heroSubtitleMobileSize  String   @default("1.05rem")
  heroSubtitleTabletSize  String   @default("1.20rem")
  heroSubtitleDesktopSize String   @default("1.35rem")
  heroFloatingIconsJson   String   @default("[]")
  sponsorsJson            String   @default("[]")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model LiveContentConfig {
  key         String   @id @default("default")
  mode        String   @default("AGENDA")
  title       String?
  local       String?
  speaker     String?
  description String?
  type        String?
  theme       String?
  day         String?
  date        DateTime?
  startTime   String?
  endTime     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id                   Int                @id @default(autoincrement())
  name                 String             @unique
  description          String
  preview              String?
  communityUrl         String?
  companyName          String
  companyCategory      String
  companyLogoUrl       String?
  companyWebsite       String?
  companyInstagram     String?
  companyLinkedin      String?
  isPaid               Boolean            @default(false)
  priceLabel           String?
  studentCount         Int                @default(0)
  accentColor          String             @default("#f97316")
  accentColorSecondary String             @default("#fb923c")
  courseColor          String             @default("#2563eb")
  sortOrder            Int                @default(0)
  isPublished          Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  likes                CourseLike[]
  enrollments          CourseEnrollment[]
}

model CourseLike {
  id        Int      @id @default(autoincrement())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId Int
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  Int
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model CourseEnrollment {
  id            Int      @id @default(autoincrement())
  student       Student  @relation(fields: [studentId], references: [id])
  studentId     Int
  course        Course   @relation(fields: [courseId], references: [id])
  courseId      Int
  studentNumber String
  studentName   String?
  studentEmail  String?
  studentCourse String?
  paymentProof  String?
  paymentPhone  String?
  paymentStatus String   @default("PENDING")
  paymentSubmittedAt DateTime?
  createdAt     DateTime @default(now())

  @@unique([studentId, courseId])
}

model PanelTopic {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  speaker     String
  time        String
  local       String
  day         String
  dateLabel   String
  icon        String
  type        String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveChatMessage {
  id        Int      @id @default(autoincrement())
  content   String
  student   Student  @relation(fields: [studentId], references: [id])
  studentId Int
  createdAt DateTime @default(now())
}

model AnalyticsSession {
  id                Int               @id @default(autoincrement())
  sessionId         String            @unique
  visitorId         String
  student           Student?          @relation(fields: [studentId], references: [id])
  studentId         Int?
  studentName       String?
  studentCourse     String?
  userRole          String?
  audience          AnalyticsAudience @default(ANONYMOUS)
  lastPageUrl       String?
  entryPageUrl      String?
  referrer          String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  deviceId          String?
  analyticsAllowed  Boolean           @default(false)
  functionalAllowed Boolean           @default(false)
  marketingAllowed  Boolean           @default(false)
  consentVersion    String?
  eventCount        Int               @default(0)
  startedAt         DateTime          @default(now())
  lastSeenAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  events            AnalyticsEvent[]

  @@index([visitorId, startedAt])
  @@index([studentId, startedAt])
  @@index([audience, startedAt])
}

model AnalyticsEvent {
  id             Int               @id @default(autoincrement())
  visitorId      String
  sessionId      String
  session        AnalyticsSession? @relation(fields: [sessionId], references: [sessionId])
  student        Student?          @relation(fields: [studentId], references: [id])
  studentId      Int?
  studentName    String?
  studentCourse  String?
  userRole       String?
  audience       AnalyticsAudience @default(ANONYMOUS)
  eventType      String
  eventCategory  AnalyticsCategory
  pageUrl        String?
  routeName      String?
  referrer       String?
  elementId      String?
  elementLabel   String?
  duration       Int?
  scrollDepth    Int?
  consentVersion String?
  metadata       Json?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime          @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([eventCategory, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([studentId, createdAt])
  @@index([audience, createdAt])
}

model ConsentRecord {
  id                Int      @id @default(autoincrement())
  visitorId         String?
  sessionId         String?
  student           Student? @relation(fields: [studentId], references: [id])
  studentId         Int?
  source            String   @default("banner")
  consentVersion    String
  essential         Boolean  @default(true)
  analytics         Boolean  @default(false)
  functional        Boolean  @default(false)
  marketing         Boolean  @default(false)
  lastVisitedPage   String?
  lastCampaign      String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([studentId, createdAt])
  @@index([visitorId, createdAt])
}

model AgendaItem {
  id          Int        @id @default(autoincrement())
  day         AgendaDay
  date        DateTime
  startTime   String
  endTime     String
  title       String
  local       String
  speaker     String
  description String
  type        AgendaType
  theme       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
