  studentId              Int?
  studentNumber          String
  studentName            String?
  studentCourse          String?
  mission                PassportMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  missionId              Int?
  sourceType             String
  sourceId               String
  points                 Int
  status                 String    @default("VALID")
  reason                 String?
  metadataJson           String?
  awardedAt              DateTime  @default(now())
  revokedAt              DateTime?
  revokedByStudentNumber String?
  revokeReason           String?

  @@index([studentNumber, awardedAt])
  @@index([studentId, awardedAt])
  @@index([missionId, awardedAt])
  @@index([status, awardedAt])
  @@index([sourceType, sourceId])
