generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum SubmissionType {
  PROJECT
  BUSINESS
  PRODUCT
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AgendaDay {
  DAY1
  DAY2
}

enum AgendaType {
  PANEL
  WORKSHOP
  PRESENTATION
  CEREMONY
  BREAK
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  createdAt   DateTime     @default(now())
  submissions Submission[] @relation("UserSubmissions")
  votes       Vote[]
  reviews     Review[]
}

model Student {
  id                Int                @id @default(autoincrement())
  studentNumber     String             @unique
  name              String?
  email             String?
  course            String?
  classCode         String?
  academicYear      String?
  academicPeriod    String?
  curricularYear    String?
  academicSyncedAt  DateTime?
  birthDate         DateTime?
  nationality       String?
  phone             String?
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  submissions       Submission[]
  likes             StudentLike[]
  courseLikes       CourseLike[]
  courseEnrollments CourseEnrollment[]
  votes             StudentVote[]
  comments          StudentComment[]
  liveChatMessages  LiveChatMessage[]
  analyticsSessions AnalyticsSession[]
  analyticsEvents   AnalyticsEvent[]
  consentRecords    ConsentRecord[]
  loginAudits       StudentLoginAudit[]
  smsRecipients     SmsCampaignRecipient[]
  whatsappRecipients WhatsAppCampaignRecipient[]
  attendanceCredential AttendanceCredential?
  attendanceCheckIns AttendanceCheckIn[]
  certificates      Certificate[]
  communityPosts        CommunityPost[]
  communityPostLikes    CommunityPostLike[]
  communityPostComments CommunityPostComment[]
  communityChatMessages CommunityChatMessage[]
}

enum StudentLoginOrigin {
  UORCONNECT
  LABORATORIO
}

enum AnalyticsAudience {
  ANONYMOUS
  AUTHENTICATED
}

enum AnalyticsCategory {
  NAVIGATION
  ENGAGEMENT
  CONVERSION
  LIVE
  AUTH
  MARKETING
  FUNCTIONAL
  CONSENT
  SECURITY
}

model AdminAuthorizedStudent {
  id            Int      @id @default(autoincrement())
  studentNumber String   @unique
  team          String   @default("Geral")
  role          String   @default("SUPER_ADMIN")
  permissions   String   @default("ALL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model JuryMember {
  id             Int              @id @default(autoincrement())
  name           String
  phone          String           @unique
  team           String           @default("Júri")
  role           String           @default("TEAM_LEAD")
  permissions    String           @default("OVERVIEW,SUBMISSIONS,VOTES,WINNERS")
  isActive       Boolean          @default(true)
  lastCodeSentAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  accessCodes    JuryAccessCode[]

  @@index([isActive, createdAt])
}

model JuryAccessCode {
  id                   Int        @id @default(autoincrement())
  juryMember           JuryMember @relation(fields: [juryMemberId], references: [id], onDelete: Cascade)
  juryMemberId         Int
  codeHash             String
  codeLast4            String
  expiresAt            DateTime
  usedAt               DateTime?
  sentAt               DateTime   @default(now())
  createdByStudentNumber String
  providerMessageId    String?
  providerResponseJson String?
  deliveryStatus       String     @default("PENDING")
  errorMessage         String?

  @@index([juryMemberId, sentAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model StudentLoginAudit {
  id            Int                @id @default(autoincrement())
  student       Student            @relation(fields: [studentId], references: [id])
  studentId     Int
  studentNumber String
  origin        StudentLoginOrigin
  loggedAt      DateTime           @default(now())

  @@index([loggedAt])
  @@index([studentId, loggedAt])
  @@index([origin, loggedAt])
}

model StudentLike {
  id           Int        @id @default(autoincrement())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  createdAt    DateTime   @default(now())

  @@unique([studentId, submissionId])
  @@index([submissionId, createdAt])
}

model StudentVote {
  id           Int        @id @default(autoincrement())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  createdAt    DateTime   @default(now())

  @@unique([studentId, submissionId])
  @@index([submissionId, createdAt])
}

model StudentComment {
  id           Int        @id @default(autoincrement())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  content      String
  createdAt    DateTime   @default(now())

  @@index([submissionId, createdAt])
  @@index([studentId, createdAt])
}

model Submission {
  id               Int              @id @default(autoincrement())
  referenceCode    String           @unique
  type             SubmissionType
  status           SubmissionStatus @default(PENDING)
  name             String
  description      String
  area             String
  course           String?
  stage            String?
  category         String?
  productType      String?
  teamSize         Int
  members          String
  leaderName       String?
  leaderPhone      String?
  leaderEmail      String
  needs            String
  paymentProof     String
  paymentConfirmed Boolean          @default(false)
  repoUrl          String?
  websiteUrl       String?
  observations     String?
  agreeRules       Boolean
  primaryColor     String           @default("#FD8305")
  secondaryColor   String           @default("#223D42")
  bannerUrl        String?
  isWinner         Boolean          @default(false)
  winnerSelectedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  leader           User             @relation("UserSubmissions", fields: [leaderId], references: [id])
  leaderId         Int
  student          Student?         @relation(fields: [studentId], references: [id])
  studentId        Int?
  studentNumberSnapshot String?
  votes            Vote[]
  reviews          Review[]
  studentLikes     StudentLike[]
  studentVotes     StudentVote[]
  studentComments  StudentComment[]

  @@index([studentId, createdAt])
}

model SubmissionConfig {
  key                 String   @id @default("default")
  isOpen              Boolean  @default(true)
  iban                String   @default("AO006 0055 0000 3295 0561 10379")
  accountName         String   @default("Universidade Óscar Ribas")
  paymentAmount       String   @default("15.000 Kz")
  paymentInstructions String?
  projectCommunityUrl String?
  businessCommunityUrl String?
  productCommunityUrl String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Vote {
  id           Int        @id @default(autoincrement())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  voter        User       @relation(fields: [voterId], references: [id])
  voterId      Int
  createdAt    DateTime   @default(now())

  @@unique([submissionId, voterId])
}

model Review {
  id           Int        @id @default(autoincrement())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId Int
  reviewer     User       @relation(fields: [reviewerId], references: [id])
  reviewerId   Int
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([submissionId, reviewerId])
}

model Speaker {
  id        Int      @id @default(autoincrement())
  name      String
  bio       String
  specialty String
  talk      String
  day       String
  linkedin  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id          Int      @id @default(autoincrement())
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuideStep {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  link        String?
  linkText    String?
  icon        String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuideTip {
  id          Int      @id @default(autoincrement())
  content     String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Venue {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  capacity    String
  floor       String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeCourse {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String
  ctaText     String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeSocialConfig {
  key                     String   @id @default("default")
  instagramUrl            String?
  facebookUrl             String?
  linkedinUrl             String?
  courseEnrollmentEnabled Boolean  @default(true)
  firstYearContestEnabled Boolean  @default(true)
  primaryColor            String   @default("#f97316")
  primaryGradient         String   @default("linear-gradient(135deg, rgba(249,115,22,0.16) 0%, rgba(251,146,60,0.28) 100%)")
  titleColor              String   @default("#111827")
  accentColor             String   @default("#f97316")
  dashedColor             String   @default("#f97316")
  dashedOpacity           Int      @default(35)
  heroIconsOpacity        Int      @default(18)
  heroBlobsIntensity      Int      @default(68)
  heroMeshEnabled         Boolean  @default(true)
  heroBadgeText           String   @default("Plataforma Académica Digital · Chave-na-Mão")
  heroTitlePrefix         String   @default("3ª edição da")
  heroTitleHighlight      String   @default("Feira do Dia das Telecomunicações")
  heroSubtitleText        String   @default("Conectando o Conhecimento Académico ao Mercado Tecnológico com Energia e Empreendedorismo.")
  heroSubtitleColor       String   @default("#4b5563")
  heroTitleMobileSize     String   @default("2.8rem")
  heroTitleTabletSize     String   @default("4.2rem")
  heroTitleDesktopSize    String   @default("5.4rem")
  heroSubtitleMobileSize  String   @default("1.05rem")
  heroSubtitleTabletSize  String   @default("1.20rem")
  heroSubtitleDesktopSize String   @default("1.35rem")
  heroFloatingIconsJson   String   @default("[]")
  sponsorsJson            String   @default("[]")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model LiveContentConfig {
  key         String   @id @default("default")
  mode        String   @default("AGENDA")
  title       String?
  local       String?
  speaker     String?
  description String?
  type        String?
  theme       String?
  day         String?
  date        DateTime?
  startTime   String?
  endTime     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id                   Int                @id @default(autoincrement())
  name                 String             @unique
  description          String
  preview              String?
  communityUrl         String?
  companyName          String
  companyCategory      String
  companyLogoUrl       String?
  companyWebsite       String?
  companyInstagram     String?
  companyLinkedin      String?
  isPaid               Boolean            @default(false)
  priceLabel           String?
  studentCount         Int                @default(0)
  accentColor          String             @default("#f97316")
  accentColorSecondary String             @default("#fb923c")
  courseColor          String             @default("#2563eb")
  sortOrder            Int                @default(0)
  isPublished          Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  likes                CourseLike[]
  enrollments          CourseEnrollment[]
}

model CourseLike {
  id        Int      @id @default(autoincrement())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId Int
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  Int
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model CourseEnrollment {
  id            Int      @id @default(autoincrement())
  student       Student  @relation(fields: [studentId], references: [id])
  studentId     Int
  course        Course   @relation(fields: [courseId], references: [id])
  courseId      Int
  studentNumber String
  studentName   String?
  studentEmail  String?
  studentCourse String?
  paymentProof  String?
  paymentPhone  String?
  paymentStatus String   @default("PENDING")
  paymentSubmittedAt DateTime?
  createdAt     DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId, createdAt])
  @@index([paymentStatus, createdAt])
}

model SmsCampaign {
  id                    Int                    @id @default(autoincrement())
  title                 String?
  message               String
  sender                String
  audienceType          String
  audienceFiltersJson   String?
  totalRecipients       Int                    @default(0)
  successCount          Int                    @default(0)
  failedCount           Int                    @default(0)
  status                String                 @default("PENDING")
  scheduleAt            DateTime?
  createdByStudentNumber String
  createdAt             DateTime               @default(now())
  sentAt                DateTime?
  recipients            SmsCampaignRecipient[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model SmsCampaignRecipient {
  id                  Int         @id @default(autoincrement())
  campaign            SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId          Int
  student             Student?    @relation(fields: [studentId], references: [id])
  studentId           Int?
  studentNumber       String?
  recipientName       String?
  recipientCourse     String?
  phone               String
  providerTo          String
  status              String      @default("QUEUED")
  providerMessageId   String?
  providerResponseJson String?
  errorMessage        String?
  sentAt              DateTime?
  createdAt           DateTime    @default(now())

  @@unique([campaignId, phone])
  @@index([campaignId])
  @@index([studentId])
  @@index([status, createdAt])
}

model WhatsAppInstance {
  id                     Int                    @id @default(autoincrement())
  name                   String                 @unique
  label                  String?
  phoneNumber            String?
  baseUrl                String?
  apiKey                 String?
  status                 String                 @default("DISCONNECTED")
  qrCode                 String?
  pairingCode            String?
  isDefault              Boolean                @default(false)
  isActive               Boolean                @default(true)
  lastConnectedAt        DateTime?
  lastCheckedAt          DateTime?
  createdByStudentNumber String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  campaigns              WhatsAppCampaign[]

  @@index([isActive, isDefault])
  @@index([status, updatedAt])
}

model WhatsAppCampaign {
  id                     Int                         @id @default(autoincrement())
  title                  String?
  message                String
  instance               WhatsAppInstance?           @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  instanceId             Int?
  instanceName           String
  audienceType           String
  audienceFiltersJson    String?
  mediaUrl               String?
  mediaType              String?
  mediaMimeType          String?
  mediaFileName          String?
  totalRecipients        Int                         @default(0)
  successCount           Int                         @default(0)
  failedCount            Int                         @default(0)
  status                 String                      @default("PENDING")
  createdByStudentNumber String
  createdAt              DateTime                    @default(now())
  sentAt                 DateTime?
  recipients             WhatsAppCampaignRecipient[]

  @@index([instanceId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

model WhatsAppCampaignRecipient {
  id                   Int              @id @default(autoincrement())
  campaign             WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId           Int
  student              Student?         @relation(fields: [studentId], references: [id])
  studentId            Int?
  studentNumber        String?
  recipientName        String?
  recipientCourse      String?
  phone                String
  providerTo           String
  status               String           @default("QUEUED")
  providerMessageId    String?
  providerResponseJson String?
  errorMessage         String?
  sentAt               DateTime?
  createdAt            DateTime         @default(now())

  @@unique([campaignId, phone])
  @@index([campaignId])
  @@index([studentId])
  @@index([status, createdAt])
}

model WhatsAppConversation {
  id           Int      @id @default(autoincrement())
  phone        String   @unique
  step         String   @default("MENU")
  data         String   @default("{}")
  studentId    Int?
  instanceName String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([updatedAt])
}

model WhatsAppAutomationSetting {
  id            Int      @id @default(autoincrement())
  eventKey      String   @unique
  label         String
  description   String
  enabled       Boolean  @default(true)
  customTitle   String?
  customMessage String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled, updatedAt])
}

model PanelTopic {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  speaker     String
  time        String
  local       String
  day         String
  dateLabel   String
  icon        String
  type        String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveChatMessage {
  id        Int      @id @default(autoincrement())
  content   String
  student   Student  @relation(fields: [studentId], references: [id])
  studentId Int
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([studentId, createdAt])
}

model AnalyticsSession {
  id                Int               @id @default(autoincrement())
  sessionId         String            @unique
  visitorId         String
  student           Student?          @relation(fields: [studentId], references: [id])
  studentId         Int?
  studentName       String?
  studentCourse     String?
  userRole          String?
  audience          AnalyticsAudience @default(ANONYMOUS)
  lastPageUrl       String?
  entryPageUrl      String?
  referrer          String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  deviceId          String?
  analyticsAllowed  Boolean           @default(false)
  functionalAllowed Boolean           @default(false)
  marketingAllowed  Boolean           @default(false)
  consentVersion    String?
  eventCount        Int               @default(0)
  startedAt         DateTime          @default(now())
  lastSeenAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  events            AnalyticsEvent[]

  @@index([visitorId, startedAt])
  @@index([studentId, startedAt])
  @@index([audience, startedAt])
  @@index([lastSeenAt])
  @@index([studentCourse, lastSeenAt])
  @@index([utmSource, lastSeenAt])
}

model AnalyticsEvent {
  id             Int               @id @default(autoincrement())
  visitorId      String
  sessionId      String
  session        AnalyticsSession? @relation(fields: [sessionId], references: [sessionId])
  student        Student?          @relation(fields: [studentId], references: [id])
  studentId      Int?
  studentName    String?
  studentCourse  String?
  userRole       String?
  audience       AnalyticsAudience @default(ANONYMOUS)
  eventType      String
  eventCategory  AnalyticsCategory
  pageUrl        String?
  routeName      String?
  referrer       String?
  elementId      String?
  elementLabel   String?
  duration       Int?
  scrollDepth    Int?
  consentVersion String?
  metadata       Json?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime          @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([eventCategory, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([studentId, createdAt])
  @@index([audience, createdAt])
}

model ConsentRecord {
  id                Int      @id @default(autoincrement())
  visitorId         String?
  sessionId         String?
  student           Student? @relation(fields: [studentId], references: [id])
  studentId         Int?
  source            String   @default("banner")
  consentVersion    String
  essential         Boolean  @default(true)
  analytics         Boolean  @default(false)
  functional        Boolean  @default(false)
  marketing         Boolean  @default(false)
  lastVisitedPage   String?
  lastCampaign      String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([studentId, createdAt])
  @@index([visitorId, createdAt])
}

model AgendaItem {
  id          Int        @id @default(autoincrement())
  day         AgendaDay
  date        DateTime
  startTime   String
  endTime     String
  title       String
  local       String
  speaker     String
  description String
  type        AgendaType
  theme       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AttendanceCredential {
  id            Int                 @id @default(autoincrement())
  token         String              @unique
  student       Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     Int                 @unique
  studentNumber String
  studentName   String?
  studentCourse String?
  label         String              @default("Credencial UOR Connect")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  checkIns      AttendanceCheckIn[]

  @@index([studentNumber])
  @@index([createdAt])
}

model AttendanceCheckIn {
  id                       Int                  @id @default(autoincrement())
  credential               AttendanceCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  credentialId             Int
  student                  Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId                Int?
  studentNumber            String
  studentName              String?
  studentCourse            String?
  eventKey                 String               @default("main-event")
  eventLabel               String               @default("Evento principal UOR Connect")
  checkedInAt              DateTime             @default(now())
  checkedInByStudentNumber String
  notes                    String?

  @@unique([credentialId, eventKey])
  @@index([studentId, checkedInAt])
  @@index([studentNumber, checkedInAt])
  @@index([checkedInAt])
}

model Certificate {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique
  validationToken       String    @unique
  type                  String
  title                 String
  recipientName         String
  recipientNumber       String?
  recipientCourse       String?
  student               Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId             Int?
  sourceType            String?
  sourceId              Int?
  issuedAt              DateTime  @default(now())
  issuedByStudentNumber String
  status                String    @default("ISSUED")
  revokedAt             DateTime?
  metadataJson          String?

  @@index([studentId, issuedAt])
  @@index([recipientNumber])
  @@index([type, issuedAt])
  @@index([status, issuedAt])
}

model AdminAuditLog {
  id                 Int      @id @default(autoincrement())
  actorStudentNumber String
  actorRole          String   @default("admin")
  action             String
  entityType         String
  entityId           String?
  summary            String
  metadataJson       String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([actorStudentNumber, createdAt])
  @@index([entityType, createdAt])
  @@index([action, createdAt])
}

// ──────────────────────────────────────────────
// Community
// ──────────────────────────────────────────────

enum CommunityPostType {
  FREE
  PROJECT_UPDATE
  COURSE_UPDATE
  ADMIN_ANNOUNCEMENT
}

enum CommunityChatContextType {
  PROJECT
  COURSE
}

model CommunityPost {
  id        Int               @id @default(autoincrement())
  studentId Int
  student   Student           @relation(fields: [studentId], references: [id])
  type      CommunityPostType @default(FREE)
  content   String
  imageUrl  String?
  contextId Int?
  hidden    Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  likes    CommunityPostLike[]
  comments CommunityPostComment[]

  @@index([createdAt])
  @@index([studentId, createdAt])
  @@index([type, createdAt])
}

model CommunityPostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, studentId])
  @@index([postId])
  @@index([studentId])
}

model CommunityPostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  content   String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([studentId])
}

model CommunityChatThread {
  id          Int                       @id @default(autoincrement())
  contextType CommunityChatContextType
  contextId   Int
  title       String?
  createdAt   DateTime                  @default(now())

  messages CommunityChatMessage[]

  @@unique([contextType, contextId])
  @@index([contextType])
}

model CommunityChatMessage {
  id        Int                 @id @default(autoincrement())
  threadId  Int
  thread    CommunityChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student             @relation(fields: [studentId], references: [id])
  content   String
  hidden    Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([threadId, createdAt])
  @@index([studentId])
}
