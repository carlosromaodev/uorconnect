NODE_ENV=production
PORT=3333
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://uorconnect:change-me@postgres:5432/uorconnect?schema=public
SQLITE_SOURCE_PATH=./dev.db
JWT_SECRET=change-me-with-at-least-16-characters
CORS_ORIGIN=https://uor-connect.vercel.app,https://www.uorconnect.ao
PUBLIC_API_URL=https://api.uorconnect.ao
INVOICE_GENERATOR_API_URL=https://invoice-generator.com
# INVOICE_GENERATOR_API_KEY=
OMBALA_API_BASE_URL=https://api.useombala.ao
# OMBALA_API_TOKEN=
OMBALA_SMS_DEFAULT_SENDER="UOR CONNECT"
RATE_LIMIT_MAX=400
RATE_LIMIT_WINDOW_MS=60000
PGPOOL_MAX=20
PGPOOL_MIN=2
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECT_TIMEOUT_MS=8000
