NODE_ENV=production
PORT=3333
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://uorconnect:change-me@postgres:5432/uorconnect?schema=public
SQLITE_SOURCE_PATH=./dev.db
JWT_SECRET=change-me-with-at-least-16-characters
CORS_ORIGIN=https://uor-connect.vercel.app,https://www.uorconnect.ao
SECRETARIA_FETCH_TIMEOUT_MS=25000
DEFAULT_ADMIN_STUDENT_NUMBERS=
PUBLIC_API_URL=https://api.uorconnect.ao
PUBLIC_APP_URL=https://www.uorconnect.ao
UORCONNECT_EVENT_NAME="UOR Connect"
UORCONNECT_EVENT_DATE="Data a confirmar"
UORCONNECT_EVENT_LOCATION="Universidade Óscar Ribas"
UORCONNECT_INSTITUTION_NAME="Universidade Óscar Ribas"
UORCONNECT_CERTIFICATE_AUTHORITY_TITLE="A Vice Reitora para os Assuntos Científicos e Pós-Graduação"
UORCONNECT_CERTIFICATE_AUTHORITY_NAME="Nome da autoridade"
UORCONNECT_CERTIFICATE_ORGANIZER_NAME="Faculdade de Ciências e Tecnologia"
MEDIA_STORAGE_DIR=storage/media
MEDIA_ORPHAN_RETENTION_DAYS=30
PDF_JOB_STORAGE_DIR=storage/pdf-jobs
PDF_JOB_RETENTION_HOURS=48
EXHIBITOR_PDF_STORAGE_DIR=storage/exhibitor-pdfs
# Webhook opcional para enviar email com o link do PDF do expositor
# EXHIBITOR_PDF_EMAIL_WEBHOOK_URL=https://mailer.example.com/uorconnect/exhibitor-pdf
ANALYTICS_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=730
CREDENTIAL_VALIDATION_LOG_RETENTION_DAYS=365
EXPIRED_CREDENTIAL_RETENTION_DAYS=365
INVOICE_GENERATOR_API_URL=https://invoice-generator.com
# INVOICE_GENERATOR_API_KEY=
OMBALA_API_BASE_URL=https://api.useombala.ao
# OMBALA_API_TOKEN=
OMBALA_SMS_DEFAULT_SENDER="UOR CONNECT"
EVOLUTION_API_BASE_URL=http://localhost:8081
# Em produção com docker-compose, use http://evolution-api:8080
# EVOLUTION_API_KEY=use-a-mesma-chave-de-AUTHENTICATION_API_KEY-do-compose-da-evolution
# ODIN 2.0 AI: nunca versionar a chave real; colocar apenas na VPS.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ODIN_AI_ENABLED=true
RATE_LIMIT_MAX=400
RATE_LIMIT_WINDOW_MS=60000
VALIDATION_RATE_LIMIT_MAX=120
VALIDATION_RATE_LIMIT_WINDOW_MS=60000
PGPOOL_MAX=20
PGPOOL_MIN=2
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECT_TIMEOUT_MS=8000
