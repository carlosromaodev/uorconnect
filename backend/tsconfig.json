{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest"],
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": true
  },
  "include": ["src", "prisma/seed.ts", "prisma.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
